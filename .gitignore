# ===== Generated experiment outputs =====
# Keep the frozen, reusable module registry in version control.  It is an
# input to reproducible S-PSO runs, unlike run logs, samples and checkpoints.
eoh/examples/tsp_gls_numba/results_spso/*
!eoh/examples/tsp_gls_numba/results_spso/fig3a_spso/
eoh/examples/tsp_gls_numba/results_spso/fig3a_spso/*
!eoh/examples/tsp_gls_numba/results_spso/fig3a_spso/module_library/
eoh/examples/tsp_gls_numba/results_spso/fig3a_spso/module_library/*
!eoh/examples/tsp_gls_numba/results_spso/fig3a_spso/module_library/module_library.json

# Local evaluation reports are regenerated by the evaluation entry points.
results.txt
eoh/examples/tsp_gls_numba/evaluation/results.txt
